# Os arquivos de static/ entram na impressão do CACHE_VERSION (ServiceWorkerVersaoTest):
# fim de linha LF fixo nos textos para a impressão ser a mesma em qualquer sistema.
# text=auto: um binário que falte na lista abaixo é detectado pelo Git e não é convertido.
src/main/resources/static/** text=auto eol=lf
src/main/resources/static/**/*.webp binary
src/main/resources/static/**/*.png binary
src/main/resources/static/**/*.woff2 binary
src/main/resources/static/**/*.mp3 binary
