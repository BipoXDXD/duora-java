{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    // O loader do vite.config.ts pede a extensão nos imports relativos (vite.config.ts → build/).
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  // O teste da cadeia de suprimentos lê package.json, lockfile e node_modules: roda no Node, ao lado
  // do detector que ele pina.
  "include": [
    "vite.config.ts",
    "tailwind.test.ts",
    "avisos-do-build.test.ts",
    "build",
    "src/telas/verificacao/cadeiaDeSuprimentos.test.ts"
  ]
}
